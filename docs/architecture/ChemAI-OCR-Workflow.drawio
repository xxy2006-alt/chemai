        <!-- 标题区 -->
        <mxCell id="title" value="智辅化学 (ChemAI) — 核心业务流程：教师答题卡批改全链路" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="教师上传答题卡 → OCR 识别 → Agent 批改 → 障碍诊断 → 班级学情报告  |  闭环耗时：从 6h 压缩到 3-45min" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="500" y="60" width="1200" height="30" as="geometry" />
        </mxCell>

        <!-- ===== 5 个泳道 ===== -->
