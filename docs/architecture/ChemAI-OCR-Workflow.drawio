        <!-- ===== 开始节点 ===== -->
        <mxCell id="start" value="开始&#xa;教师收到一沓答题卡" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="180" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- ===== 教师上传文件 ===== -->
        <mxCell id="t1" value="1. 批量上传答题卡&#xa;（图片/PDF）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="170" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t1-confirm" value="2. 确认上传 / 设置参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="170" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="3. 说出指令：&#xa;&quot;帮我批了&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="170" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t3" value="4. 查看 OCR 进度&#xa;（实时）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="170" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t4-decision" value="5. 确认批改？&#xa;（是/否）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="175" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="t5" value="6. 逐学生结果卡片确认&#xa;（修正 AI 批改）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="170" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t6" value="7. 保存批改结果&#xa;（save_grading_results）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1500" y="170" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t7" value="8. 查看班级统计&#xa;+ 学情报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="170" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t8" value="9. 通知家长 +&#xa;推送错题给学生" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1940" y="170" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- ===== Agent 节点 ===== -->
        <mxCell id="a1" value="接收请求&#xa;Gateway 意图分类" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="385" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="调用 query_ocr_progress&#xa;查询 OCR 任务进度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="385" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="确认批改&#xa;（教师同意）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="385" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="调用 grade_answer_sheets&#xa;触发 LLM 语义批改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1280" y="385" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="逐学生批改结果&#xa;→ SSE 流式推送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1500" y="385" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="教师确认/修正&#xa;结构化引导" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="385" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a7" value="调用 save_grading_results&#xa;保存 + 触发诊断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1940" y="385" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a8" value="调用 diagnose_barrier&#xa;三维障碍分类" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1500" y="475" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a9" value="调用 show_diagnosis&#xa;聚合班级数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="475" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a10" value="调用 send_notification&#xa;推送给家长/学生" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;" vertex="1">
          <mxGeometry x="1940" y="475" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a11" value="输出 SSE 流：&#xa;text + tool_call + component&#xa;异步推送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="555" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a12" value="GuardState 校验：&#xa;工具调用去重 + 频率限制 + 审批门禁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="540" y="555" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a13" value="AsyncSqliteSaver checkpointer：&#xa;多轮对话断点恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="840" y="555" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a14" value="Persona 过滤：仅 18 教师工具可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#EF4444;strokeWidth=1;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1120" y="555" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ===== 审核引擎节点 ===== -->
        <mxCell id="aud1" value="审核 1：系数配平&#xa;元素原子计数法 → 100% 准确" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#F59E0B;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1280" y="710" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="aud2" value="审核 2：反应条件&#xa;14 类条件关键词规则库 ≥80%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#F59E0B;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1280" y="785" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="aud-decision" value="四维全部通过？&#xa;（配平/条件/产物/结构）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#DC2626;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1540" y="710" width="180" height="130" as="geometry" />
        </mxCell>

        <mxCell id="aud-pass" value="✓ 硬拦截通过&#xa;输出给用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A7F3D0;strokeColor=#10B981;strokeWidth=1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1770" y="720" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="aud-fail" value="✗ 拦截：&#xa;返回错误 + 重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#DC2626;strokeWidth=1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1770" y="785" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="aud-guard" value="核心红线：&#xa;方程式系数配平必须零错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="740" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="aud-product" value="审核 3：产物稳定性&#xa;化学合理性规则库 ≥80%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#F59E0B;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="740" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="aud-structure" value="审核 4：分子结构&#xa;化学式格式检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#F59E0B;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="740" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- ===== 业务服务节点 ===== -->
        <mxCell id="s1" value="OCR 双引擎调度&#xa;MinerU + 百度 OCR&#xa;APScheduler 后台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="910" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="OCRTask 状态机&#xa;pending → processing → done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="920" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="LLM 批改服务&#xa;DeepSeek / GPT-4 多 Provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="920" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="答案来源三选一&#xa;题库匹配 / 教师粘贴 / LLM 自行判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="920" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="写入 StudentAnswer&#xa;+ 触发 barrier 诊断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1320" y="920" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="障碍分类规则引擎&#xa;concept / reading / expression&#xa;+ LLM 深入分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1580" y="920" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="置信度计算&#xa;&lt; 0.7 标记&#xa;&quot;建议人工复核&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1840" y="920" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="数据存储&#xa;SQLite + Alembic 迁移&#xa;23 模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="1010" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s9" value="通知服务&#xa;多通道（微信/钉钉/短信）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1840" y="1010" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- ===== 学生/家长节点 ===== -->
        <mxCell id="u1" value="学生接收错题推送&#xa;+ 个性化学习计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1170" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u2" value="学生完成自适应练习&#xa;+ 错题强化训练" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1820" y="1170" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u3" value="家长接收通俗周报&#xa;（微信/钉钉推送）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1820" y="1240" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u4" value="学生 AI 辅导对话&#xa;（苏格拉底式提问）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1240" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- ===== 结束节点 ===== -->
        <mxCell id="end" value="完成&#xa;闭环用时 ≤45min" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#10B981;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2000" y="1230" width="120" height="70" as="geometry" />
        </mxCell>

        <!-- ===== 教师泳道内箭头 ===== -->
        <mxCell id="e1" style="endArrow=classic;html=1;strokeColor=#3B82F6;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="start" target="t1">
          <mxGeometry relative="1" as="geometry" />
