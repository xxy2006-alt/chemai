        <!-- 教师→Agent -->
        <mxCell id="e-t2-a1" value="自然语言指令" style="endArrow=classic;html=1;strokeColor=#EF4444;strokeWidth=2;fontSize=10;fontColor=#B91C1C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t2" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a1-a2" value="SSE 推送进度" style="endArrow=classic;html=1;strokeColor=#EF4444;strokeWidth=2;fontSize=10;fontColor=#B91C1C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a2-a3" style="endArrow=classic;html=1;strokeColor=#EF4444;strokeWidth=2;" edge="1" parent="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Agent→教师 -->
