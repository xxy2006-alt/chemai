        <mxCell id="lane-auditor-title" value="四维安全审核引擎" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#B45309;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="50" y="720" width="40" height="100" as="geometry" />
