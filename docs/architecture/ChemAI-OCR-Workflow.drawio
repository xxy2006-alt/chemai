        <mxCell id="lane-agent-title" value="ChemAI Agent&#xa;LangGraph ReAct" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#B91C1C;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="50" y="430" width="40" height="160" as="geometry" />
