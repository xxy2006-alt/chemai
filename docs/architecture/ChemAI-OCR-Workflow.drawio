          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" parent="1" source="t1-confirm" target="t2">
          <mxGeometry relative="1" as="geometry" />
