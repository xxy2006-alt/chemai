        <mxCell id="lane-teacher-title" value="教师 (Teacher Persona)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1E40AF;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="40" height="100" as="geometry" />
        </mxCell>

        <!-- 泳道2: Agent -->
