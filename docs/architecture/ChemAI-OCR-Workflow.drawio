        <mxCell id="lane-user-title" value="学生 / 家长 (Student &amp; Parent)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#15803D;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="50" y="1170" width="40" height="100" as="geometry" />
